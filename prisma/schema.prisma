generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Post {
  id                    Int            @id @default(autoincrement())
  title                 String
  slug                  String         @unique
  meta_description      String
  featured_image_prompt String
  reading_time          String
  created_at            DateTime       @default(now())
  published_at          DateTime?
  status                String         @default("draft")
  featured_image_url    String?
  categories            Category[]
  images                Image[]
  internal_links        InternalLink[]
  keywords              Keyword[]
  products              Product[]
  sections              Section[]

  @@map("posts")
}

model Category {
  id      Int    @id @default(autoincrement())
  post_id Int
  name    String
  post    Post   @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@map("categories")
}

model Product {
  id          Int     @id @default(autoincrement())
  post_id     Int
  name        String
  price       String?
  url         String?
  description String?
  post        Post    @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@map("products")
}

model Section {
  id           Int     @id @default(autoincrement())
  post_id      Int
  heading      String
  content_html String
  order_index  Int
  images       Image[]
  post         Post    @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@map("sections")
}

model Image {
  id         Int      @id @default(autoincrement())
  post_id    Int
  section_id Int?
  prompt     String
  alt_text   String
  url        String?
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  section    Section? @relation(fields: [section_id], references: [id])

  @@map("images")
}

model InternalLink {
  id          Int    @id @default(autoincrement())
  post_id     Int
  anchor_text String
  target_slug String
  post        Post   @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@map("internal_links")
}

model Keyword {
  id      Int    @id @default(autoincrement())
  post_id Int
  keyword String
  post    Post   @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@map("keywords")
}

model AutomationTask {
  id                            Int       @id @default(autoincrement())
  niche                         String
  category                      String
  products                      String
  target_url                    String?
  tone                          String    @default("Professional & Informative")
  audience                      String
  status                        String    @default("PENDING")
  posts_per_day                 Int       @default(2)
  schedule_type                 String    @default("INTERVAL") // INTERVAL, DAILY
  interval_hours                Int?      @default(12)
  schedule_time                 String?   // "09:00"
  days_of_week                  String?   // "1,3,5" (0=Sun, 6=Sat)
  publication_lead_time_hours   Int       @default(0)
  generation_buffer_minutes     Int       @default(30)
  last_run                      DateTime?
  next_run                      DateTime?
  created_at                    DateTime  @default(now())
  team_id                       Int?
  team                          Team?     @relation(fields: [team_id], references: [id])

  @@map("automation_tasks")
}

model Team {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  task_type   String       @default("GENERAL") // CONTENT_WRITING, DATA_EXTRACTION, SEO, MEDIA, GENERAL
  is_template Boolean      @default(true)
  members     TeamMember[]
  tasks       AutomationTask[]
  created_at  DateTime     @default(now())

  @@map("teams")
}

model TeamMember {
  id           Int      @id @default(autoincrement())
  team_id      Int
  role         String   // extract, write, refine, worker_1..worker_4, image, video, faq, social, translate, summarize, tts
  model_id     String
  model_label  String
  instructions String?
  hf_token     String?  // optional dedicated HF token for this member
  groq_key     String?  // optional dedicated Groq key for this member
  priority     Int      @default(0)
  is_active    Boolean  @default(true)
  team         Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  created_at   DateTime @default(now())

  @@unique([team_id, role])
  @@map("team_members")
}

model SystemSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}
